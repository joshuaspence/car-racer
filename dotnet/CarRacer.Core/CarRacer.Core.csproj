<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Builds the engine-independent game core outside Unity so it can be unit tested with
    `dotnet test` (locally and in CI, no Unity licence needed). The sources live inside the
    Unity project, where Unity compiles them as the CarRacer.Core assembly.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <!-- Match Unity's C# compiler so code that builds here also builds in Unity. -->
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>CarRacer.Core</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Unity/Assets/CarRacer/Core/**/*.cs" />
  </ItemGroup>

</Project>
