* text=auto eol=lf

# Unity YAML assets: let Unity's Smart Merge handle conflicts if configured.
*.unity    text merge=unityyamlmerge eol=lf
*.prefab   text merge=unityyamlmerge eol=lf
*.asset    text merge=unityyamlmerge eol=lf
*.mat      text merge=unityyamlmerge eol=lf
*.meta     text eol=lf

# Binary assets
*.png  binary
*.jpg  binary
*.fbx  binary
*.glb  binary
*.wav  binary
*.ogg  binary
*.mp3  binary
*.ttf  binary
*.otf  binary

# Assets the game reads itself (Kenney OBJ models and PNGs, kept byte for byte)
*.bytes binary
